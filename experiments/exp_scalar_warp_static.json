        "T": 80.0,
        "dt": 0.04,
        "c": 1.0,
        "boundary": "periodic"
    },
    "initial_conditions": {
        "type": "gaussian_pulse",
        "center": 20.0,
        "width": 5.0,
        "amplitude": 1.0
    },
    "output": {
        "save_interval": 10,
        "export_csv": true,
        "export_plots": true,
        "export_animation": true
    }
